[Unit]
Description=Enable PS5 fan control
After=dev-icc.device
ConditionPathExists=/dev/icc

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ps5_control --fan max
ExecStop=/usr/local/sbin/ps5_control --fan off
# The pattern change above reloads the firmware target (86 on Slim), overriding
# the kernel's boot value. This write is used here; 80 is a quieter alternative.
ExecStartPost=/bin/sh -c 'echo 75 > /sys/bus/platform/devices/ps5-fan/target_temp'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
